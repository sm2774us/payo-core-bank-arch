# Example only — real secrets are provisioned via External Secrets Operator
# pulling from AWS Secrets Manager (see infra/terraform/modules/rds), never
# committed to this repo. Copy this file, fill it, and `kubectl create secret
# generic ledger-core-secrets --from-env-file=secrets.env -n payo-core`.
DATABASE_URL=postgresql+asyncpg://REPLACE:REPLACE@REPLACE:5432/ledger
KAFKA_BOOTSTRAP_SERVERS=REPLACE
